# Copy to .env and fill in values

# SQLite for local dev; swap for Postgres in production
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Enable the Gmail API and add scope https://www.googleapis.com/auth/gmail.readonly
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Where uploaded resumes are stored on disk
UPLOAD_DIR="./uploads"

# Optional: path to a Chromium binary for browser-based auto-apply fallback
# PLAYWRIGHT_EXECUTABLE_PATH="/opt/pw-browsers/chromium"

# Safety switch: auto-apply submits real applications only when "true".
# Otherwise it runs in dry-run mode (fills forms, records everything, does not submit).
AUTO_APPLY_LIVE="false"
